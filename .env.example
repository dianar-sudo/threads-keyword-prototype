# Threads App ID and Threads App Secret from Meta's Threads use case settings
THREADS_APP_ID=
THREADS_APP_SECRET=

# Set this to the exact public Vercel URL + callback route after the first deploy.
# Example: https://your-project.vercel.app/api/auth/threads/callback
THREADS_REDIRECT_URI=

# Generate a private random string (32+ characters). Never use the App Secret here.
THREADS_SESSION_SECRET=

# Public origin of the deployed site, without a trailing slash.
# Example: https://your-project.vercel.app
APP_URL=

# Keep the API version configurable in case Meta changes the current version.
THREADS_API_VERSION=v1.0
